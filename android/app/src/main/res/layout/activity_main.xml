<?xml version="1.0" encoding="utf-8"?>
<!-- Main capture screen, laid out like the iPhone app's ContentView: full-bleed camera, status card on
     top, segmented mode picker + mode title + [Sessions] (Record) [Settings] [Nav] at the bottom.
     Everything else lives in the Settings sheet (MainActivity.showSettings). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <FrameLayout
        android:id="@+id/previewHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/idleHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:alpha="0.35"
            android:contentDescription="@null"
            android:src="@drawable/ic_camera" />

        <TextView
            android:id="@+id/idleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/idle_hint"
            android:textColor="@color/ios_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/recTimer"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_capsule_red"
            android:fontFeatureSettings="tnum"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#fff"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="00:12"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_material_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="6"
                android:textColor="#fff"
                android:textSize="13sp"
                tools:text="Ready" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ios_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <com.real2sim.capture.SegmentedControl
            android:id="@+id/modeControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/modeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ios_secondary"
            android:textSize="12sp"
            tools:text="A · RGB-D + poses (ARCore)" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSessions"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_circle_material"
                android:contentDescription="@string/sessions"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder" />

            <com.real2sim.capture.RecordButton
                android:id="@+id/btnRecord"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_circle_material"
                android:contentDescription="@string/settings"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear" />

            <LinearLayout
                android:id="@+id/btnNav"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="28dp"
                android:background="@drawable/bg_circle_material"
                android:clickable="true"
                android:contentDescription="@string/navigate"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav"
                    android:textColor="#fff"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
