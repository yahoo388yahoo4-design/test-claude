<resources>
    <!-- Dark, iOS-like: system blue accent, black window, translucent "material" cards drawn in Ui.kt. -->
    <style name="Theme.Capture" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="colorControlActivated">@color/ios_blue</item>
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_secondary</item>
    </style>

    <!-- Bottom sheet (Ui.Sheet): full-window dialog, dimmed backdrop, slides up like an iOS sheet. -->
    <style name="Theme.Capture.Sheet" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@style/SheetAnimation</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="colorControlActivated">@color/ios_blue</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
